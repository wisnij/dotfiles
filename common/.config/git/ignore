# -*- gitignore -*-

# git dirs (git itself already skips these, but other tools like ripgrep use this file)
.git/

# Emacs backup/temp files
**/#*
**/*~
**/.#*
.markdown-preview.html

# Vim swap files
*.swp

# Mac/Windows folder metadata
.DS_Store
desktop.ini

# ignore anything containing .gitignore, except `.gitignore` exactly
*.gitignore
*.gitignore.*
!.gitignore

# ignore a top-level local dir
/local/

# Jupyter notebooks
.ipynb_checkpoints/
.jupyter/

# Environment settings which may contain passwords, tokens, etc
.env

# local LLM files
.claude/
CLAUDE.local.md
